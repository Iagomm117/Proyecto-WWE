	<queryString language="SQL">
		<![CDATA[SELECT loitador.nome, COUNT(combate_loitador.id_combate) AS total 
             FROM loitador 
             JOIN combate_loitador ON loitador.id_loitador = combate_loitador.id_loitador 
             GROUP BY loitador.id_loitador, loitador.nome 
             ORDER BY total DESC LIMIT 5]]>
	</queryString>
	<field name="nome" class="java.lang.String"/>
	<field name="total" class="java.lang.Long"/>
