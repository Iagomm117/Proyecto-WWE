	<queryString language="SQL">
		<![CDATA[SELECT * FROM (SELECT nome_grupo, COUNT(id_ppv) AS total FROM grupo_ppv JOIN ppv ON grupo_ppv.id_grupo_ppv = ppv.id_grupo_ppv GROUP BY grupo_ppv.id_grupo_ppv, nome_grupo) AS subconsulta ORDER BY total DESC LIMIT 5]]>
